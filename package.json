{
  "name": "gitsorted",
  "version": "0.1.0",
  "private": true,
  "description": "Clean up your GitHub repositories: overview, duplicate detection, bulk archive & delete.",
  "license": "MIT",
  "author": "Daniel Gietmann",
  "homepage": "https://gitsorted.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielgtmn/gitsorted.git"
  },
  "bugs": "https://github.com/danielgtmn/gitsorted/issues",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "mongodb": "^7.8.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
