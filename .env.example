# Random secret, at least 32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: anonymous landing-page stats (totals only). Leave empty to disable.
# MONGODB_URL=mongodb://user:pass@host:27017/gitsorted?authSource=admin
MONGODB_URL=

# Optional: operator details for /impressum and /datenschutz (+ footer links).
# Pages are off unless LEGAL_NAME, LEGAL_ADDRESS and LEGAL_EMAIL are set.
# LEGAL_ADDRESS lines are separated by "|".
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_NOTE=
LEGAL_HOSTING=
LEGAL_AUTHORITY=
